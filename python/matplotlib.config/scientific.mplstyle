font.serif : Computer Modern Roman
mathtext.fontset: cm
font.size:12

# Axes

axes.labelsize:14
axes.titlesize:15
axes.linewidth:1.0
axes.grid: True

## Grid visibility
axes.grid.axis: both
axes.grid.which:major

# Grid
grid.color:gray
grid.linestyle:--
grid.linewidth:0.5
grid.alpha:0.5



# Ticks
xtick.labelsize: 11
ytick.labelsize: 11
xtick.direction :in
ytick.direction :in
xtick.major.size:5
ytick.major.size:5

# figure
figure.figsize: 14, 8
figure.dpi:150

#Export
savefig.dpi:300
savefig.format: png
savefig.bbox:tight
#legend
legend.fontsize:11
legend.frameon:False

